{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RocketCompanion",
  "version": "1.0.0",
  "identifier": "com.antigravity.rocketcompanion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3003",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rocket Companion",
        "url": "index.html",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "configurator",
        "title": "Rocket Companion — Launch Configurator",
        "url": "index.html?configurator=1",
        "width": 720,
        "height": 680,
        "minWidth": 620,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    }
  }
}


