{
  "name": "rocket-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Rocket Companion — A high-performance 3D vehicle & ball simulation engine powered by Three.js and RocketSim WebAssembly.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "node --experimental-strip-types scripts/git/ensureGitHooks.ts",
    "hooks:install": "node --experimental-strip-types scripts/git/ensureGitHooks.ts",
    "predev": "node scripts/syncPrivateProfile.mjs",
    "dev": "node --experimental-strip-types scripts/devLauncher.ts",
    "dev:entry": "RC_VITE_ROLE=entry vite",
    "dev:rc": "RC_VITE_ROLE=rc-https vite",
    "dev:tuner": "RC_VITE_ROLE=tuner vite",
    "dev:tauri-http": "RC_VITE_ROLE=rc-http vite",
    "tauri": "tauri",
    "tauri:dev": "node --experimental-strip-types scripts/tauriDevWatch.ts",
    "tauri:dev:tray": "RC_TRAY_ONLY=1 node --experimental-strip-types scripts/tauriDevWatch.ts",
    "tauri:dev:raw": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icons": "node scripts/generateTauriCrossbarIcons.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "preview": "vite preview",
    "sync:profile": "node scripts/syncPrivateProfile.mjs --force",
    "typecheck": "tsc --noEmit",
    "radar": "node --experimental-strip-types scripts/radar.ts",
    "radar:audit": "node --experimental-strip-types scripts/radar.ts --audit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "check": "pnpm run radar && pnpm run typecheck",
    "extract:golden": "node scripts/extractGoldenBaseline65f1538d.mjs",
    "test:baseline": "node scripts/runScenarioBaseline.mjs",
    "test:soak": "node scripts/runSoakWatchdog.mjs",
    "test:multiplayer-suite": "node --experimental-strip-types scripts/runMultiplayerSuiteTests.ts",
    "test:dev-room-sync-e2e": "node scripts/runDevRoomSyncE2E.mjs",
    "repro:dev-sync-bugs": "node scripts/runDevSyncReproSuite.mjs",
    "repro:multiplayer-room": "node scripts/runMultiplayerRoomRepro.mjs",
    "repro:multiplayer-chaos": "node --experimental-strip-types scripts/runMultiplayerChaosRepro.ts",
    "repro:sync-issues": "node scripts/runTsWithVite.mjs scripts/runMultiplayerSyncIssuesRepro.ts",
    "repro:dev-broadcast-v2": "node scripts/runDevBroadcastReproV2.mjs",
    "repro:dev-broadcast-v3": "node scripts/runDevBroadcastReproV3.mjs",
    "repro:dev-extra-routes": "node scripts/runDevSyncExtraRoutesE2E.mjs",
    "env:check": "node scripts/env/checkEnv.mjs",
    "env:setup": "bash scripts/env/bootstrap.sh",
    "env:setup:rust": "bash scripts/env/bootstrap.sh --with-rust"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^5.0.0"
  }
}
