{
  "name": "rocket-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Rocket Companion — A high-performance 3D vehicle & ball simulation engine powered by Three.js and RocketSim WebAssembly.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "predev": "node scripts/syncPrivateProfile.mjs",
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "preview": "vite preview",
    "sync:profile": "node scripts/syncPrivateProfile.mjs --force",
    "typecheck": "tsc --noEmit",
    "radar": "node --experimental-strip-types scripts/radar.ts",
    "radar:audit": "node --experimental-strip-types scripts/radar.ts --audit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "check": "pnpm run radar && pnpm run typecheck",
    "extract:golden": "node scripts/extractGoldenBaseline65f1538d.mjs",
    "test:baseline": "node scripts/runScenarioBaseline.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^5.0.0"
  }
}
